# Demo environment template (REQ-DEMO-003). Copy to .env (`make up` does it when .env is missing).
# Do not commit .env, .env.dev or .env.*.local files.

# PORT: Host port mapped to the FrankenPHP (Caddy) HTTP service in docker-compose.yml.
PORT=8011

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, debug toolbar).
APP_ENV=dev

# APP_DEBUG: Enable detailed debug output (1 in dev, 0 in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: Secret used for CSRF/session signing. Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> symfony/routing ###
# DEFAULT_URI: Base URL used to generate URLs from the CLI (e.g. links in alert e-mails); keep it in sync with PORT.
DEFAULT_URI=http://localhost:8011
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL: Doctrine DSN for the demo MySQL service (`database` host inside Compose, REQ-DEMO-011).
# docker-compose.yml sets the same value for the php and checks services.
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
# MERCURE_PORT: Host port of the Mercure hub container (debugging only; the browser uses the Caddy proxy below).
MERCURE_PORT=3080

# MERCURE_URL: Hub URL used by PHP to publish updates (internal Compose network).
MERCURE_URL=http://mercure/.well-known/mercure

# MERCURE_PUBLIC_URL: Hub URL used by the browser to subscribe (proxied by the demo Caddy on PORT).
MERCURE_PUBLIC_URL=http://localhost:8011/.well-known/mercure

# MERCURE_JWT_SECRET: Shared publisher/subscriber JWT key of the demo hub. Local-only placeholder.
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
###< symfony/mercure-bundle ###
