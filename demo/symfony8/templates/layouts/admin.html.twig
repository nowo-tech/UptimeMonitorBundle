{#
  Demo host layout (REQ-UI-003 nowo_ui_kit.layouts.admin, REQ-DEMO-014): the UiKit admin layout with its default theme
  and the UiKit masthead in nowo_ui_navigation; no CSS framework, no CDN, no token override. Every Uptime Monitor
  admin page (UiKit scaffolds) renders inside it; the bundle ships no layout and no CDN link.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Uptime Monitor demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('nowo_uptime_tenant_index') }}"{% if _route starts with 'nowo_uptime_tenant' %} aria-current="page"{% endif %}>Tenants</a>
            <a class="nowo-ui-link" href="{{ path('nowo_uptime_dashboard', { tenantSlug: 'main' }) }}"{% if _route == 'nowo_uptime_dashboard' %} aria-current="page"{% endif %}>Dashboard</a>
            <a class="nowo-ui-link" href="{{ path('nowo_uptime_settings_index', { tenantSlug: 'main' }) }}"{% if _route starts with 'nowo_uptime_settings' %} aria-current="page"{% endif %}>Settings</a>
            <a class="nowo-ui-link" href="{{ path('nowo_uptime_status_page', { tenantSlug: 'main' }) }}"{% if _route == 'nowo_uptime_status_page' %} aria-current="page"{% endif %}>Status page</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}
