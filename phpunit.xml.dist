<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source ignoreSuppressionOfDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- REQ-SF-005: the deprecation gate is PHPUnit's own (failOnDeprecation + ignoreSuppressionOfDeprecations).
             PHPUnit 11 removed restrictDeprecations and reports self, direct and indirect deprecations by default
             (the restrictDeprecations="false" behaviour): any deprecation, including Symfony's silenced
             trigger_deprecation() calls, fails the run. symfony/phpunit-bridge's deprecation handler does not run on
             PHPUnit >= 10; the bridge setting below is kept only for parity. Tests of the bundle's own deprecated 1.x
             config keys assert them with expectUserDeprecationMessage(); PageContractTest documents the one
             third-party exception (UiKit's PageContractTestCase, issue #123). -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[direct]=0"/>
    </php>
</phpunit>
