<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.27.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes).
     Used with nowo_uptime_monitor.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\UptimeMonitorBundle\Entity\CheckAggregate" table="uptime_check_aggregate">
        <unique-constraints>
            <unique-constraint name="uniq_uptime_aggregate_bucket" columns="monitor_id,period,period_start"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="checksTotal" type="integer"/>
        <field name="checksUp" type="integer"/>
        <field name="checksDown" type="integer"/>
        <field name="uptimeRatio" type="float"/>
        <field name="latencyAvgMs" type="integer"/>
        <field name="period" type="string" length="8" enum-type="Nowo\UptimeMonitorBundle\Enum\AggregatePeriod"/>
        <field name="periodStart" column="period_start" type="datetime_immutable"/>
        <many-to-one field="monitor" target-entity="Nowo\UptimeMonitorBundle\Entity\Monitor">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
