{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nowo-tech/UptimeMonitorBundle/schema/apply-monitors.v1.json",
  "title": "UptimeMonitorBundle apply-monitors file, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tenants"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "const": 1
    },
    "tenants": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tenant"
      }
    }
  },
  "$defs": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitors"
      ],
      "properties": {
        "monitors": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/pushMonitor"
          }
        }
      }
    },
    "pushMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "name",
        "url_key",
        "interval_seconds"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "type": {
          "const": "push"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "url_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 31536000
        },
        "grace_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 86400
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "resend_notification_after_down": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "paused": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thresholds": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "disk": {
              "$ref": "#/$defs/percentLimit"
            },
            "inodes": {
              "$ref": "#/$defs/percentLimit"
            },
            "memory": {
              "$ref": "#/$defs/percentLimit"
            },
            "cpu": {
              "$ref": "#/$defs/percentLimit"
            },
            "swap": {
              "$ref": "#/$defs/percentLimit"
            },
            "load": {
              "$ref": "#/$defs/limit"
            }
          }
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warn",
        "critical"
      ],
      "properties": {
        "warn": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "critical": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "percentLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warn",
        "critical"
      ],
      "properties": {
        "warn": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "critical": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "description": "Monitors file of nowo:uptime:apply-monitors (UptimeMonitorBundle 1.18+). Entry keys are unique across the whole file; url_key values too. Tokens never go in this file. null in an optional field means absent (the default)."
}
