{#
  Settings → Tags (REQ-UI-003): UiKit settings scaffold.
  Variables: page (View\SettingsPage from SettingsController: header settings.title with a back link to the dashboard;
  one section per settings screen with its href (section tabs), current = this screen), and the 1.x variables
  tenant, tenant_slug, section, section_title. Section "tags": form = TagFormType, submit settings.tags.add_button; tags
  (list<Tag>), tag_delete_actions (tag id => View\Action: POST + CSRF FormView behind the UiKit confirm dialog),
  1.x tag_delete_forms.
  Data block filled: nowo_ui_settings_section (tag list with delete actions, then parent(): the add-tag form).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_robots.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    <div class="uptime-app uptime-app--embedded uptime-settings-body uptime-settings-tags" data-testid="uptime-settings-{{ section.id }}">
        <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'settings.tags.list'|trans }}</h3>
        {% if tags is empty %}
            {{ include(nowo_ui_partial('empty', _b), {message: 'settings.tags.empty'|trans, bundle: _b}, false) }}
        {% else %}
            <ul class="uptime-tag-list">
                {% for tag in tags %}
                    <li class="uptime-tag-list__item">
                        <span class="uptime-tag-list__name">
                            {% if tag.color %}<span class="uptime-tag-swatch" data-color="{{ tag.color }}" aria-hidden="true"><svg viewBox="0 0 10 10" width="10" height="10" focusable="false"><circle cx="5" cy="5" r="5" fill="{{ tag.color }}"/></svg></span>{% endif %}
                            {{ tag.name }}
                        </span>
                        {% if tag_delete_actions[tag.id] is defined %}
                            {{ include(nowo_ui_partial('action', _b), {action: tag_delete_actions[tag.id], context: 'row', bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'settings.tags.add'|trans }}</h3>
        {{ parent() }}
    </div>
{% endblock %}
