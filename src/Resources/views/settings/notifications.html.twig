{#
  Settings → Notifications (REQ-UI-003): UiKit settings scaffold.
  Variables: page (View\SettingsPage from SettingsController: header settings.title with a back link to the dashboard;
  one section per settings screen with its href (section tabs), current = this screen), and the 1.x variables
  tenant, tenant_slug, section, section_title. Section "notifications" (no form); notification_items (list<View\DetailItem>: enabled, cooldown,
  email, webhook, Slack), 1.x notifications_config.
  Data block filled: nowo_ui_settings_section (notes + the UiKit `detail_list` partial).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_robots.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    <div class="uptime-app uptime-app--embedded uptime-theme-{{ uptime_theme() }} uptime-settings-body" data-testid="uptime-settings-{{ section.id }}"{% if uptime_theme() != 'auto' %} data-theme="{{ uptime_theme() }}"{% endif %}>
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'settings.notifications.intro'|trans|raw }}</p>
        {{ include(nowo_ui_partial('detail_list', _b), {items: notification_items, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'settings.notifications.per_monitor'|trans }}</p>
    </div>
{% endblock %}
