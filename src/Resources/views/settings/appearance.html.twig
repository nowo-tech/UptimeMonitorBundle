{#
  Settings → Appearance (REQ-UI-003): UiKit settings scaffold.
  Variables: page (View\SettingsPage from SettingsController: header settings.title with a back link to the dashboard;
  one section per settings screen with its href (section tabs), current = this screen), and the 1.x variables
  tenant, tenant_slug, section, section_title. Section "appearance": form = SettingsAppearanceFormType, submit settings.save.
  Data block filled: nowo_ui_settings_section (interface language notice, then parent(): the section form).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_robots.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    {% set _locale = app.request.locale|default('en') %}
    <div class="uptime-app uptime-app--embedded uptime-theme-{{ uptime_theme() }} uptime-settings-body" data-testid="uptime-settings-{{ section.id }}"{% if uptime_theme() != 'auto' %} data-theme="{{ uptime_theme() }}"{% endif %}>
        <div class="uptime-settings-locale-notice">
            <p class="uptime-settings-locale-notice__label">{{ 'settings.appearance.locale'|trans }}</p>
            <p class="uptime-settings-locale-notice__value">
                <strong>{{ _locale }}</strong>
                {% if _locale in ['en', 'es'] %}— {{ ('settings.appearance.locale_name.' ~ _locale)|trans }}{% endif %}
            </p>
            <p class="uptime-settings-locale-notice__help {{ nowo_ui_class('muted', _b) }}">{{ 'settings.appearance.locale_help'|trans }}</p>
        </div>
        {{ parent() }}
    </div>
{% endblock %}
