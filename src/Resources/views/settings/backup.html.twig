{#
  Settings → Backup (REQ-UI-003): UiKit settings scaffold.
  Variables: page (View\SettingsPage from SettingsController: header settings.title with a back link to the dashboard;
  one section per settings screen with its href (section tabs), current = this screen), and the 1.x variables
  tenant, tenant_slug, section, section_title. Section "backup": form = BackupImportFormType (multipart), submit settings.backup.import_button;
  export_action (View\Action: GET JSON export).
  Data block filled: nowo_ui_settings_section (export block with its action, then parent(): the import form).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_robots.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    <div class="uptime-app uptime-app--embedded uptime-settings-body" data-testid="uptime-settings-{{ section.id }}">
        <section class="uptime-settings-block">
            <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'settings.backup.export_title'|trans }}</h3>
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'settings.backup.export_intro'|trans }}</p>
            <div class="{{ nowo_ui_class('toolbar', _b) }}"{{ nowo_ui_attrs('toolbar', _b) }}>
                {{ include(nowo_ui_partial('action', _b), {action: export_action, context: 'toolbar', bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
            </div>
        </section>
        <section class="uptime-settings-block">
            <h3 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'settings.backup.import_title'|trans }}</h3>
            {# REQ-TWIG-005: BackupImportFormType (flat names action / import_mode / backup / _token, multipart via FileType). #}
            {{ parent() }}
        </section>
    </div>
{% endblock %}
