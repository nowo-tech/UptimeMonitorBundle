{#
  Monitor detail (REQ-UI-003): UiKit show scaffold. Variables: page (View\ShowPage from MonitorController::show():
  header = monitor name, intro = target, back link to the dashboard, the actions the user may use (Edit opens the
  monitor form dialog, a plain link without JavaScript; Pause / Resume; Delete behind a confirm) and the host's;
  section "details" (type, group / project, target, interval)), page_sections (UptimePageEvent: before / after),
  log_events + log_pagination (the check log page, web_ui.per_page), and the 1.x variables tenant_slug, monitor,
  latest, detail, chart_series_json, latency_series_json, api_history_url, api_aggregates_url; push (server health
  view of a push monitor, null otherwise — _push_health.html.twig).
  Since 1.18 the first card header also renders the block monitor_origin_badge ("Managed from file (<key>)" for a
  monitor of nowo:uptime:apply-monitors; empty otherwise).
  Data blocks filled: nowo_ui_show_sections (the UiKit detail cards; since 1.17 the first one carries the status badge
  in its header — UiKit badge classes per status and data-status-badges, the translated label and classes of every
  status, so uptime-monitor-detail.js never prints a raw status), nowo_ui_show_after (host sections, check history
  bar, uptime / latency figures, charts, check log, group children — sibling cards on the page, no card around them;
  updated live by uptime-monitor-detail.js; until the first check one notice stands for the history, figures, charts
  and log, which the script reveals once a check arrives). Chart colours: the --uptime-chart-* custom properties.
  Since 1.21 (web_ui.monitor_show, variable monitor_layout): the regions sit in the blocks monitor_details,
  monitor_figures and monitor_charts; slots.details / slots.figures replace a region with a host template (rendered
  with the page variables), charts: host renders slots.charts instead of the bundle charts, charts: none drops them.
  monitor is the raw entity (unmasked target and config, push key): a slot prints monitor_safe.target / .config.
  Since 1.24 (MUX-100, MUX-101): on phones (under 30rem) the figures are two columns; the check log is a stacked list
  under 40rem of card width (status badge, time, latency, code when there is one, then the message; same
  uptime-phone-* hooks as the table dashboard).
  Since 1.30 (web_ui.monitor_show; every default renders the 1.29 markup): the history, log, children and push
  regions are blocks too (monitor_history, monitor_log, monitor_children, monitor_push); slots.history / slots.log
  replace a region; order (monitor_layout.order, the full list) renders the regions in that order inside the script
  root, each check-dependent one in its own data-detail-pending wrapper, details inside the root only when listed;
  log options (monitor_layout.log: sortable headers through log_sort, align_numbers, time_format,
  time_title_format); header.status puts the live status badge in the UiKit page header (page_status) instead of the
  first details card; api_history_url null (MonitorShowLiveUpdatesEvent) renders no data-api-history, and
  monitor_root_attributes adds the host's attributes (validated names, escaped values) to the root.
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_robots.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('uptime-monitor-detail.js', 'nowo_uptime_monitor') }}"></script>
{% endblock %}

{# 1.30, web_ui.monitor_show.header.status: the live status badge next to the title (UiKit page_status). #}
{% block nowo_ui_page_header %}{% if monitor_layout.header.status|default(false) %}
    {% set _b = page.bundle %}
    {% set _tones = {up: 'success', down: 'danger', degraded: 'warning', unknown: 'neutral'} %}
    {% set _status = latest ? latest.status.value : 'unknown' %}
    {% set _status = _tones[_status] is defined ? _status : 'unknown' %}
    {% set _badges = {} %}
    {% for _key, _tone in _tones %}
        {% set _badges = _badges|merge({(_key): {label: ('status.' ~ _key)|trans, class: nowo_ui_class('page_status', _b) ~ ' ' ~ nowo_ui_class('badge_' ~ _tone, _b) ~ ' uptime-status-badge uptime-status-badge--' ~ _key, tone: _tone}}) %}
    {% endfor %}
    {% set _header = page.header.withStatus(nowo_ui_dialog_status({
        label: _badges[_status].label,
        tone: _tones[_status],
        attributes: {
            class: 'uptime-status-badge uptime-status-badge--' ~ _status,
            'data-detail-status': true,
            'data-testid': 'uptime-monitor-status',
            'data-status-badges': _badges|json_encode,
        },
    })) %}
    {{ include('@NowoUiKitBundle/page/_page_header.html.twig', {header: _header, bundle: _b, nowo_ui_page_type: 'show', extra_actions: [], header_actions: true, presentation: null}, false) }}
{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    {% set _status = latest ? latest.status.value : 'unknown' %}
    {% set _badges = {} %}
    {% for _key, _slot in {up: 'badge_success', down: 'badge_danger', degraded: 'badge_warning', unknown: 'badge_neutral'} %}
        {% set _badges = _badges|merge({(_key): {label: ('status.' ~ _key)|trans, class: 'uptime-status-badge uptime-status-badge--' ~ _key ~ ' ' ~ nowo_ui_class(_slot, _b)}}) %}
    {% endfor %}
    {% set _layout = monitor_layout|default({charts: 'bundle', slots: {}}) %}
{% if 'details' not in (_layout.order|default([])) %}    {% block monitor_details %}
    {% if _layout.slots.details|default(null) %}
        {{ include(_layout.slots.details) }}
    {% else %}
    {% for section in page.sections %}
        <section class="{{ nowo_ui_class('section', _b) }} {{ nowo_ui_class('card', _b) }}"{% if section.id %} id="{{ section.id }}"{% endif %} data-nowo-ui-region="section"{{ nowo_ui_attrs('section', _b) }}>
            {% if section.title or loop.first %}
                <header class="{{ nowo_ui_class('card_header', _b) }}{% if loop.first %} uptime-details-header{% endif %}">
                    {% if section.title %}<h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ section.title|nowo_ui_trans }}</h2>{% endif %}
                    {% if loop.first %}
{% if not (_layout.header.status|default(false)) %}                        <p class="uptime-details-status">
                            <span class="visually-hidden">{{ 'dashboard.col.status'|trans }}:</span>
                            <span class="{{ (_badges[_status] ?? _badges.unknown).class }}" data-detail-status data-testid="uptime-monitor-status"
                                  data-status-badges="{{ _badges|json_encode|e('html_attr') }}">{{ (_badges[_status] ?? _badges.unknown).label }}</span>
                        </p>
{% endif %}                        {# 1.18: a monitor applied from a monitors file (nowo:uptime:apply-monitors) says so in the header.
                           Hosts that override this page reuse the block (view fields monitor.fileManaged, monitor.originKey). #}
                        {% block monitor_origin_badge %}
                            {% if monitor.fileManaged|default(false) %}
                                <p class="uptime-details-origin">
                                    <span class="{{ nowo_ui_class('badge_neutral', _b) }} uptime-file-badge" data-testid="uptime-monitor-origin-badge">{{ 'monitor.origin.file_badge'|trans({'%key%': monitor.originKey}) }}</span>
                                </p>
                            {% endif %}
                        {% endblock %}
                    {% endif %}
                </header>
            {% endif %}
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {{ include(nowo_ui_partial('detail_list', _b), {items: section.items, bundle: _b, nowo_ui_page_type: 'show'}, false) }}
            </div>
        </section>
    {% endfor %}
    {% endif %}
    {% endblock %}
{% endif %}{% endblock %}

{% block nowo_ui_show_after %}
    {% set _b = page.bundle %}
    {% set _theme = uptime_theme() %}
    {% set _layout = monitor_layout|default({charts: 'bundle', slots: {}}) %}
{% set _order = _layout.order|default([]) %}{% set _root_attrs = monitor_root_attributes|default({}) %}    {% for section in page_sections.before|default([]) %}
        {{ include(section.template, section.context) }}
    {% endfor %}
    <div class="uptime-app uptime-app--embedded uptime-theme-{{ _theme }} uptime-page uptime-page--monitor"{% if _theme != 'auto' %} data-theme="{{ _theme }}"{% endif %}>
        <div class="uptime-detail{% if _root_attrs.class is defined %} {{ _root_attrs.class }}{% endif %}" id="uptime-monitor-detail-root"
             data-monitor-id="{{ monitor.id }}"
{% if api_history_url is not null %}             data-api-history="{{ api_history_url }}"
{% endif %}             data-series="{{ chart_series_json|e('html_attr') }}"
             data-latency-series="{{ latency_series_json|e('html_attr') }}"{% for _name, _value in _root_attrs %}{% if _name != 'class' %} {{ _name|e('html_attr') }}{% if _value is not same as(true) %}="{{ _value }}"{% endif %}{% endif %}{% endfor %}>
{% if _order is empty %}

{% block monitor_children %}            {% if monitor.type.value == 'group' and detail.children is not empty %}
                <section class="uptime-group-children uptime-flat-section">
                    <h2 class="uptime-flat-section__title">{{ 'monitor.show.group_children'|trans }}</h2>
                    <ul class="uptime-group-child-list">
                        {% for child in detail.children %}
                            {% set child_status = child.latest ? child.latest.status.value : 'unknown' %}
                            <li>
                                <a href="{{ path('nowo_uptime_monitor_show', {tenantSlug: tenant_slug, id: child.monitor.id}) }}">{{ child.monitor.name }}</a>
                                <span class="uptime-status uptime-status-{{ child_status }}">{{ ('status.' ~ child_status)|trans }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
{% endblock %}

{% block monitor_push %}            {% if push|default(null) %}
                {{ include('@NowoUptimeMonitorBundle/monitor/_push_health.html.twig') }}
            {% endif %}
{% endblock %}

            {% if not latest %}
                <p class="uptime-detail-unchecked {{ nowo_ui_class('muted', _b) }}" role="status" data-detail-unchecked data-testid="uptime-monitor-no-checks">{{ 'monitor.show.not_checked'|trans }}</p>
            {% endif %}

            <div class="uptime-detail-checked-content" data-detail-pending{% if not latest %} hidden{% endif %}>
{% block monitor_history %}{% if _layout.slots.history|default(null) %}{{ include(_layout.slots.history) }}{% else %}            <section class="uptime-detail-history-section {{ nowo_ui_class('card', _b) }}"{{ nowo_ui_attrs('card', _b) }}>
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'monitor.show.history'|trans }}</h2>
                {{ include('@NowoUptimeMonitorBundle/_history_bar.html.twig', {history: detail.history, large: true}) }}
                <p class="uptime-history-legend {{ nowo_ui_class('muted', _b) }}">
                    <span>{{ 'monitor.show.older'|trans }}</span>
                    <span aria-hidden="true">→</span>
                    <span>{{ 'monitor.show.now'|trans }}</span>
                    {% if latest %}
                        · {{ 'monitor.show.last_check'|trans }} <span data-detail-checked>{{ latest.checkedAt|date('Y-m-d H:i:s') }}</span>
                        · {{ 'monitor.show.interval'|trans({'%seconds%': monitor.intervalSeconds}) }}
                    {% endif %}
                </p>
            </section>
{% endif %}{% endblock %}

            {% block monitor_figures %}
            {% if _layout.slots.figures|default(null) %}
                {{ include(_layout.slots.figures) }}
            {% else %}
            <section class="uptime-metrics-cards {{ nowo_ui_class('kpis', _b) }}"{{ nowo_ui_attrs('kpis', _b) }}>
                <div class="uptime-metric-card {{ nowo_ui_class('kpi', _b) }}">
                    <span class="uptime-metric-label {{ nowo_ui_class('kpi_label', _b) }}">{{ 'monitor.show.uptime_24h'|trans }}</span>
                    <span class="uptime-metric-value {{ nowo_ui_class('kpi_value', _b) }}" data-uptime-24h>{{ detail.uptime_24h is not null ? detail.uptime_24h|number_format(1) ~ '%' : '—' }}</span>
                </div>
                <div class="uptime-metric-card {{ nowo_ui_class('kpi', _b) }}">
                    <span class="uptime-metric-label {{ nowo_ui_class('kpi_label', _b) }}">{{ 'monitor.show.uptime_30d'|trans }}</span>
                    <span class="uptime-metric-value {{ nowo_ui_class('kpi_value', _b) }}" data-uptime-30d>{{ detail.uptime_30d is not null ? detail.uptime_30d|number_format(1) ~ '%' : '—' }}</span>
                </div>
                <div class="uptime-metric-card {{ nowo_ui_class('kpi', _b) }}">
                    <span class="uptime-metric-label {{ nowo_ui_class('kpi_label', _b) }}">{{ 'monitor.show.latency'|trans }}</span>
                    <span class="uptime-metric-value {{ nowo_ui_class('kpi_value', _b) }}" data-detail-latency>{{ latest ? latest.latencyMs ~ ' ms' : '—' }}</span>
                </div>
            </section>
            {% endif %}
            {% endblock %}

            {% block monitor_charts %}
            {% if _layout.charts == 'host' %}
                {% if _layout.slots.charts|default(null) %}{{ include(_layout.slots.charts) }}{% endif %}
            {% elseif _layout.charts != 'none' %}
            <section class="uptime-charts uptime-detail-charts">
                {% if not push|default(null) %}
                <div class="uptime-chart-box {{ nowo_ui_class('card', _b) }}">
                    <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'monitor.show.chart_response'|trans }}</h2>
                    <canvas id="uptime-chart-response" height="140"></canvas>
                </div>
                {% endif %}
                <div class="uptime-chart-box {{ nowo_ui_class('card', _b) }}">
                    <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'monitor.show.chart_uptime'|trans }}</h2>
                    <canvas id="uptime-chart-uptime" height="120"></canvas>
                </div>
                <div class="uptime-chart-box {{ nowo_ui_class('card', _b) }}">
                    <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'monitor.show.chart_latency'|trans }}</h2>
                    <canvas id="uptime-chart-latency" height="120"></canvas>
                </div>
            </section>
            {% endif %}
            {% endblock %}

{% block monitor_log %}{% set _log = _layout.log|default({}) %}{% set _sort = log_sort|default(null) %}{% set _num = _log.align_numbers|default(false) %}{% if _layout.slots.log|default(null) %}{{ include(_layout.slots.log) }}{% else %}            <section class="uptime-events uptime-phone-list {{ nowo_ui_class('card', _b) }}"{{ nowo_ui_attrs('card', _b) }} data-testid="uptime-monitor-log" aria-labelledby="uptime-monitor-log-title">
                <header class="uptime-events-header {{ nowo_ui_class('card_header', _b) }}">
                    <h2 class="{{ nowo_ui_class('card_title', _b) }}" id="uptime-monitor-log-title">{{ 'monitor.show.check_log'|trans }}</h2>
                </header>
                {# A plain scroller: the host's table_wrap slot may be a panel of its own (a card in the card). #}
                <div class="uptime-table-scroll">
                    <table class="uptime-events-table uptime-phone-table {{ nowo_ui_class('table', _b) }}" data-events-table>
                        <thead class="{{ nowo_ui_class('table_head', _b) }}">
                            <tr>
{% if _sort or _num %}
{% import '@NowoUptimeMonitorBundle/monitor/_log_macros.html.twig' as _log_ui %}
                                {{ _log_ui.th('monitor.show.col.status'|trans, 'status', _sort, false) }}
                                {{ _log_ui.th('monitor.show.col.datetime'|trans, 'time', _sort, false) }}
                                {{ _log_ui.th('monitor.show.col.latency'|trans, 'latency', _sort, _num) }}
                                {{ _log_ui.th('monitor.show.col.code'|trans, 'code', _sort, _num, 3) }}
{% else %}
                                <th scope="col">{{ 'monitor.show.col.status'|trans }}</th>
                                <th scope="col">{{ 'monitor.show.col.datetime'|trans }}</th>
                                <th scope="col">{{ 'monitor.show.col.latency'|trans }}</th>
                                <th scope="col" data-nowo-ui-priority="3">{{ 'monitor.show.col.code'|trans }}</th>
{% endif %}
                                <th scope="col">{{ 'monitor.show.col.message'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in log_events|default(detail.events|reverse) %}
                                <tr>
                                    <td data-uptime-phone="status"><span class="uptime-status uptime-status-{{ event.status }}">{{ ('status.' ~ event.status)|trans }}</span></td>
                                    <td data-uptime-phone="meta"><time datetime="{{ event.checked_at|date('c') }}"{% if _log.time_title_format|default(null) %} title="{{ event.checked_at|date(_log.time_title_format) }}"{% endif %}>{{ event.checked_at|date(_log.time_format|default('Y-m-d H:i:s')) }}</time></td>
                                    <td{% if _num %} class="uptime-cell-num"{% endif %} data-uptime-phone="meta">{{ event.latency_ms }} ms</td>
                                    <td{% if _num %} class="uptime-cell-num"{% endif %} data-nowo-ui-priority="3" data-uptime-phone="{{ event.status_code is null ? 'hidden' : 'meta' }}" data-label="{{ 'monitor.show.col.code'|trans }}">{{ event.status_code ?? '—' }}</td>
                                    <td class="uptime-event-message" data-uptime-phone="detail">{{ event.message ?? '—' }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="{{ nowo_ui_class('table_cell_muted', _b) }}">{{ 'dashboard.no_events'|trans }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if log_pagination is defined and log_pagination.totalPages > 1 %}
                    <div class="uptime-events-pagination" data-testid="uptime-monitor-log-pagination">
                        {{ include(nowo_ui_partial('pagination', _b), {pagination: log_pagination, item_count: log_events|length, bundle: _b}, false) }}
                    </div>
                {% endif %}
            </section>
{% endif %}{% endblock %}            </div>
{% else %}
{# 1.30, web_ui.monitor_show.order: the regions in the configured order (monitor_layout.order, the full list). #}
{% set _status = latest ? latest.status.value : 'unknown' %}
{% set _badges = {} %}
{% for _key, _slot in {up: 'badge_success', down: 'badge_danger', degraded: 'badge_warning', unknown: 'badge_neutral'} %}
    {% set _badges = _badges|merge({(_key): {label: ('status.' ~ _key)|trans, class: 'uptime-status-badge uptime-status-badge--' ~ _key ~ ' ' ~ nowo_ui_class(_slot, _b)}}) %}
{% endfor %}
            {% if not latest %}
                <p class="uptime-detail-unchecked {{ nowo_ui_class('muted', _b) }}" role="status" data-detail-unchecked data-testid="uptime-monitor-no-checks">{{ 'monitor.show.not_checked'|trans }}</p>
            {% endif %}
{% for _region in _order %}
    {% set _region_html %}{{ block('monitor_' ~ _region) }}{% endset %}
    {% if _region_html|trim is empty %}
    {% elseif _region in ['history', 'figures', 'charts', 'log'] %}
            <div class="uptime-detail-checked-content" data-detail-pending data-uptime-region="{{ _region }}"{% if not latest %} hidden{% endif %}>{{ _region_html }}</div>
    {% else %}
            {{ _region_html }}
    {% endif %}
{% endfor %}
{% endif %}
        </div>
    </div>
    {% for section in page_sections.after|default([]) %}
        {{ include(section.template, section.context) }}
    {% endfor %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/monitor/_monitor_edit_modal.html.twig', {bundle: page.bundle}) }}
{% endblock %}
