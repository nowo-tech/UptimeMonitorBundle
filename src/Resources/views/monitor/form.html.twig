{#
  Monitor create / edit (REQ-UI-003): UiKit form scaffold. Variables: page (View\FormPage from MonitorController:
  header monitor.new / monitor.edit, back link to the dashboard; form = MonitorFormType; submit monitor.form.save,
  cancel = dashboard; formThemes = web_ui.form_themes), and the 1.x variables tenant_slug, form, title, monitor.
  Data blocks filled: nowo_ui_form_body (type-dependent fieldsets, then the REQ-TWIG-003 child loop),
  nowo_ui_form_aside (group monitors hint).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoUptimeMonitorBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# uptime-dashboard.js shows the fieldsets of the selected monitor type ([data-monitor-type-select]) #}
    <script type="module" src="{{ asset('uptime-dashboard.js', 'nowo_uptime_monitor') }}"></script>
{% endblock %}

{% block nowo_ui_form_body %}
    {% set _theme = uptime_theme() %}
    <div class="uptime-app uptime-app--embedded uptime-theme-{{ _theme }} uptime-monitor-form-fields"{% if _theme != 'auto' %} data-theme="{{ _theme }}"{% endif %}>
        {{ include('@NowoUptimeMonitorBundle/monitor/_monitor_form_fields.html.twig') }}
    </div>
{% endblock %}

{% block nowo_ui_form_aside %}
    <aside class="uptime-form-hint {{ nowo_ui_class('card', page.bundle) }}"{{ nowo_ui_attrs('card', page.bundle) }}>
        <p class="{{ nowo_ui_class('muted', page.bundle) }}">{{ 'monitor.form.hint'|trans|raw }}</p>
    </aside>
{% endblock %}
