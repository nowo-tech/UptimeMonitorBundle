{#
  Monitor form fragment of the monitor dialog (loaded by uptime-dashboard.js / uptime-monitor-detail.js). Variables:
  form (MonitorFormType), uptime_form_themes (web_ui.form_themes), optional bundle.
#}
{% trans_default_domain 'NowoUptimeMonitorBundle' %}
{% set _b = bundle|default('NowoUptimeMonitorBundle') %}
{% if uptime_form_themes|default([]) is not empty %}
    {% form_theme form with uptime_form_themes %}
{% endif %}
{{ form_start(form, {attr: {class: ('uptime-monitor-form ' ~ nowo_ui_class('form', _b))|trim, 'data-monitor-form': '1'}}) }}
    {{ include('@NowoUptimeMonitorBundle/monitor/_monitor_form_fields.html.twig') }}
    <div class="uptime-form-actions {{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
        <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'monitor.form.save'|trans }}</button>
        <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'monitor.form.cancel'|trans }}</button>
    </div>
{{ form_end(form) }}
