{% extends uptime_layout %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set kit_fw = uptime_ui_framework == 'bootstrap' ? 'bootstrap5' : uptime_ui_framework|default('tabler') %}

{% block title %}{{ title }}{% endblock %}

{% block uptime_content %}
    <nav class="uptime-nav">
        <a href="{{ path('nowo_uptime_tenant_index') }}">← Tenants</a>
    </nav>
    <h2>{{ title }}</h2>
    {% include '@NowoUptimeMonitorBundle/_form_theme.html.twig' %}
    {{ form_start(form) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.name) }}
        <button type="submit" class="{{ ui.btn('primary', null, kit_fw) }}">Create tenant</button>
    {{ form_end(form) }}
{% endblock %}
